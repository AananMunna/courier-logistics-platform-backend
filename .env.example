# ==============================
# App
# ==============================
NODE_ENV=development
PORT=5000
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

# ==============================
# Database (PostgreSQL + Prisma)
# ==============================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/courier_db?schema=public"

# ==============================
# Auth
# ==============================
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your_google_client_id

# ==============================
# Seeded accounts (created automatically on server start)
# ==============================
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@courier.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=admin@courier.com
TESTER_ADMIN_PASSWORD=Admin@123

TESTER_RIDER_NAME=Tester Rider
TESTER_RIDER_EMAIL=rider@courier.com
TESTER_RIDER_PASSWORD=Rider@123

TESTER_CUSTOMER_NAME=Tester Customer
TESTER_CUSTOMER_EMAIL=customer@courier.com
TESTER_CUSTOMER_PASSWORD=Customer@123

# ==============================
# Redis
# ==============================
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================
# Email (Gmail SMTP via Nodemailer)
# ==============================
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_SENDER=your_gmail_address@gmail.com

# ==============================
# Cloudinary (profile images, rider NID images)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# bKash (Tokenized Checkout — Sandbox)
# ==============================
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME=your_bkash_sandbox_username
BKASH_PASSWORD=your_bkash_sandbox_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_CALLBACK_URL="http://localhost:5000/api/v1/payments/callback"

# ==============================
# Pricing (delivery fee calculation)
# ==============================
BASE_DELIVERY_FEE=50
PER_KM_FEE=10
PER_KG_FEE=15
