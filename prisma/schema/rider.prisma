model Rider {
  id String @id @default(uuid())

  name    String
  email   String  @unique
  address String?

  vehicleType             VehicleType
  vehicleRegistrationNumber String    @unique
  nidNumber               String      @unique
  drivingLicenseNumber    String?

  contactNumber String?
  currentZone   String?

  isAvailable Boolean @default(true)
  rating         Decimal @default(5.0) @db.Decimal(3, 2)
  totalDeliveries Int    @default(0)
  totalFailed     Int    @default(0)

  verificationStatus RiderVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?

  nidImageUrl      String?
  nidImagePublicId String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  shipments Shipment[]

  @@index([email], name: "idx_rider_email")
  @@index([verificationStatus], name: "idx_rider_verificationStatus")
  @@index([currentZone], name: "idx_rider_currentZone")
  @@index([isAvailable], name: "idx_rider_isAvailable")
  @@map("riders")
}
